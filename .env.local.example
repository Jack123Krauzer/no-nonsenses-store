# =============================================
# No-Nonsense Store — Environment Variables
# Copy this file to .env.local and fill in.
# Never commit .env.local to version control.
# =============================================

# --- Shopify Storefront API (public, read-only) ---
# Used by the storefront to list products, collections, cart.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# --- Shopify Admin API (private, server-only) ---
# Used by the admin panel to create/update/delete products & inventory.
# Generate in Shopify Admin > Apps > Develop apps > API credentials
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_admin_access_token
SHOPIFY_API_VERSION=2025-04

# --- Razorpay (server-only) ---
# https://dashboard.razorpay.com > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Exposed to client ONLY for Razorpay checkout widget (safe – key ID is public)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# --- Admin Panel Security ---
# Simple token-based auth for the admin panel API routes.
# Generate with: openssl rand -hex 32
ADMIN_SECRET_TOKEN=change_me_to_a_secure_random_string

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
